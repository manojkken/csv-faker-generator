{
  "name": "csv-faker-generator",
  "version": "2.4.0",
  "description": "Generate CSV, JSON, or NDJSON files with fake data: 27+ data types, alphanumeric strings, pick from custom values, formula fields, decimal precision, custom delimiters. Perfect for testing and prototyping.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "csv-faker": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manojkken/csv-faker-generator.git"
  },
  "homepage": "https://github.com/manojkken/csv-faker-generator#readme",
  "bugs": {
    "url": "https://github.com/manojkken/csv-faker-generator/issues"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/index.test.js"
  },
  "keywords": [
    "csv",
    "faker",
    "fake-data",
    "generator",
    "uuid",
    "csv-generator",
    "mock-data",
    "alphanumeric",
    "formula",
    "calculated-fields",
    "enum",
    "pick",
    "delimiter",
    "test-data",
    "prototyping",
    "iban",
    "banking",
    "json",
    "ndjson",
    "fixtures"
  ],
  "author": "Manoj Kengudelu",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/example.*",
    "!dist/test-advanced.*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "csv-writer": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
